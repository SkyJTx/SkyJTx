{
  "name": "@skyjt/signals-solid",
  "version": "0.1.2",
  "description": "SolidJS signal helpers with a Vue-like API.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "Nattakarn Khumsupha (SkyJT)",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkyJTx/SkyJTx"
  },
  "homepage": "https://github.com/SkyJTx/SkyJTx",
  "bugs": {
    "url": "https://github.com/SkyJTx/SkyJTx/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "solid",
    "solidjs",
    "signals",
    "reactivity"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "bun-types": "^1.3.11",
    "rimraf": "^5.0.5",
    "tsup": "^8.1.0",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.5.4"
  },
  "browser": {},
  "typesVersions": {}
}
