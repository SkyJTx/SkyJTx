{
  "name": "@skyjt/runtime-adapters",
  "version": "0.1.0",
  "description": "Universal runtime hosting adapters and deployment emitters for Web Standard SSR applications",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./bun": {
      "types": "./src/bun.ts",
      "import": "./src/bun.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    },
    "./cloudflare": {
      "types": "./src/cloudflare.ts",
      "import": "./src/cloudflare.ts"
    },
    "./vercel": {
      "types": "./src/vercel.ts",
      "import": "./src/vercel.ts"
    },
    "./aws-lambda": {
      "types": "./src/aws-lambda.ts",
      "import": "./src/aws-lambda.ts"
    },
    "./custom": {
      "types": "./src/custom.ts",
      "import": "./src/custom.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxlint": "~1.79.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
