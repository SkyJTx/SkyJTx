{
  "name": "@skyjt/typed-routes",
  "version": "0.1.0",
  "description": "End-to-end compile-time typed routes and parameter validation for SolidJS",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src"
  },
  "license": "MIT",
  "peerDependencies": {
    "@solidjs/router": "^2.0.0-next.21 || ^2.0.0-next.23",
    "@solidjs/web": "^2.0.0-rc.6 || ^2.0.0-rc.7",
    "filesystem-routing": "^0.2.1",
    "solid-js": "^2.0.0-rc.6 || ^2.0.0-rc.7"
  },
  "devDependencies": {
    "@solidjs/router": "^2.0.0-next.24",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.43",
    "@solidjs/web": "^2.0.0-rc.8",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/node": "^22.20.3",
    "filesystem-routing": "0.2.1",
    "jsdom": "^25.0.1",
    "oxlint": "~1.79.0",
    "solid-js": "^2.0.0-rc.8",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^3.25.76"
  }
}
