{
  "name": "@skyjt/typed-routes",
  "version": "0.1.0",
  "description": "End-to-end compile-time typed routes and parameter validation for SolidJS",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./adapters": {
      "types": "./src/adapters/runtime/index.ts",
      "import": "./src/adapters/runtime/index.ts"
    },
    "./adapters/bun": {
      "types": "./src/adapters/runtime/bun.ts",
      "import": "./src/adapters/runtime/bun.ts"
    },
    "./adapters/node": {
      "types": "./src/adapters/runtime/node.ts",
      "import": "./src/adapters/runtime/node.ts"
    },
    "./adapters/cloudflare": {
      "types": "./src/adapters/runtime/cloudflare.ts",
      "import": "./src/adapters/runtime/cloudflare.ts"
    },
    "./adapters/vercel": {
      "types": "./src/adapters/runtime/vercel.ts",
      "import": "./src/adapters/runtime/vercel.ts"
    },
    "./adapters/aws-lambda": {
      "types": "./src/adapters/runtime/aws-lambda.ts",
      "import": "./src/adapters/runtime/aws-lambda.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src"
  },
  "license": "MIT",
  "peerDependencies": {
    "@solidjs/router": "^2.0.0-next.21 || ^2.0.0-next.23",
    "@solidjs/web": "^2.0.0-rc.6 || ^2.0.0-rc.7",
    "filesystem-routing": "^0.2.1",
    "solid-js": "^2.0.0-rc.6 || ^2.0.0-rc.7"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.47",
    "@solidjs/router": "^2.0.0-next.23",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.40",
    "@solidjs/web": "^2.0.0-rc.7",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/node": "^22.10.0",
    "filesystem-routing": "0.2.1",
    "jsdom": "^25.0.1",
    "oxlint": "~1.79.0",
    "solid-js": "^2.0.0-rc.7",
    "typescript": "^5.9.3",
    "valibot": "^1.2.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zod": "^3.24.2"
  }
}
