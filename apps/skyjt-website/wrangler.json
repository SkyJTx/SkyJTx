{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyjt-website",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "observability": {
    "enabled": true
  }
}
